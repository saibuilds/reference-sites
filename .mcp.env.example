# --------------------------------------------------------------------------
# MCP credentials template.  Copy to ".mcp.env" (gitignored) and fill in,
# OR set these as environment variables in your Claude Code on the web
# environment settings (recommended for the web app — a local file is NOT
# read automatically there).
#
# .mcp.json references these names via ${VAR} expansion. No secret ever
# lives in a tracked file.
# --------------------------------------------------------------------------

# Nano Banana via the "nano-banana" MCP server (@nanana-ai/mcp-server-
# nano-banana) — VERIFIED: it reads NANANA_API_TOKEN, a nanana.app account
# token, NOT a Google Gemini key. Sign in at nanana.app -> API Access ->
# generate a token. (For real Gemini 2.5 Flash Image without a third-party
# reseller, prefer the fal-ai server below with FAL_KEY.)
NANANA_API_TOKEN=

# Optional: a Google AI Studio key (AIzaSy...) for calling Gemini directly.
# Not consumed by any wired MCP server — kept only for direct REST use.
GEMINI_API_KEY=

# Google Stitch (AI UI -> design). Create a real API key in Stitch:
# Settings -> API key -> Create key.  An "AQ.Ab8RN6..." value is an OAuth
# session token, not a stable API key — likely needs to be regenerated.
STITCH_API_KEY=

# fal.ai — umbrella host that serves BOTH nano-banana AND Seedance 2.0
# (bytedance/seedance-2.0/*). Get a key at fal.ai/dashboard/keys.
FAL_KEY=

# Replicate — alternate umbrella (Seedance 2.0 = bytedance/seedance-2.0).
# Token format: r8_...  Get it at replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=

# Higgsfield (Kling 3.0, video/image). Needs BOTH id and secret from
# cloud.higgsfield.ai/api-keys. VERIFIED: higgsfield-mcp@0.2.0 reads
# HF_API_KEY / HF_SECRET internally; .mcp.json maps these vars to those
# names, so set them under THESE names here / in Settings -> Environment.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# AWS (for the "aws-api" MCP — used to inventory / pull the old DJ Custom
# Reno site off AWS during migration to Cloudflare). Standard AWS creds.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Cloudflare MCP servers (cloudflare-bindings, cloudflare-browser) use
# OAuth on first connect — no key here. They need a fresh session with
# network access; you'll approve the OAuth prompt in the client.
